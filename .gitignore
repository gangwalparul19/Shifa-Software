# =============================================================================
# Shifa Herbal Remedies — application-level .gitignore
# Backend- and frontend-specific rules also live in backend/.gitignore and
# frontend/.gitignore. This file covers repo-wide build output, dependencies,
# secrets, deploy artifacts and runtime data.
# =============================================================================

# --- Build output ------------------------------------------------------------
**/target/
**/dist/
**/out-tsc/
**/build/
**/.angular/cache/

# --- Dependencies ------------------------------------------------------------
**/node_modules/

# --- Secrets / environment (NEVER commit) ------------------------------------
*.env
!*.env.example
**/local-secrets.properties
*.key
*.pem
*.p12
*.keystore
secrets/

# --- Deploy artifacts (generated by deploy/package-local.ps1) ----------------
/shifa-deploy.zip
/deploy-bundle/

# --- Runtime data (server/local generated; do not version) -------------------
# Generated PDFs, uploaded screenshots/logos and nightly DB backups.
**/storage/
backend/storage/

# --- Logs --------------------------------------------------------------------
*.log
**/*-log.txt
compile-log.txt
deploy-build-log.txt
test-log.txt
build-wave2.txt
mvn-out.txt
**/shifa_build.txt
**/admin-build.txt

# --- Local DB / tool state ---------------------------------------------------
.jqwik-database

# --- Stray build/scratch files -----------------------------------------------
$null
build-admin.txt
build-storefront.txt
compile-out.txt
zipsize.txt

# --- IDE / editor ------------------------------------------------------------
.idea/
*.iml
.vscode/
.settings/
.classpath
.project
.history/

# --- OS -----------------------------------------------------------------------
.DS_Store
Thumbs.db
