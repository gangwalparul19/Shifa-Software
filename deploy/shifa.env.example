# =============================================================================
# Shifa OMS backend environment (production).
# Copy to /etc/shifa/shifa.env on the server and fill in real values.
# Loaded by the systemd unit (EnvironmentFile). NEVER commit real secrets.
# =============================================================================

# Run with the production Spring profile
SPRING_PROFILES_ACTIVE=prod

# --- Database (self-hosted MySQL 8 on the same VM) ---------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shifa_dashboard
DB_USERNAME=shifa
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# --- Security ---------------------------------------------------------------
# Long random string (>= 32 chars). Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET

# Initial seeded admin (created on first boot if missing)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_PACKING_USERNAME=packer
SEED_PACKING_PASSWORD=CHANGE_ME_PACKER_PASSWORD

# --- Integrations (kept in MOCK/SANDBOX for the demo) ------------------------
PAYMENT_MODE=SANDBOX
PAYMENT_SANDBOX_SECRET=CHANGE_ME_SANDBOX_SECRET
COURIER_MODE=MOCK
WHATSAPP_MODE=MOCK

# --- Email (MOCK logs only; SMTP sends via Gmail app password) ---------------
MAIL_MODE=MOCK
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Shifa Herbal Remedies <no-reply@shifa.local>
# Daily sales digest recipient(s); blank disables the digest email
REPORT_DIGEST_TO=
REPORT_DIGEST_CRON=0 30 6 * * *

# --- Branded HTML email templates (app.mail.brand.*) -------------------------
# All optional; sensible on-brand defaults are used when unset.
#MAIL_BRAND_NAME=Shifa Herbal Remedies
#MAIL_BRAND_TAGLINE=Pure herbal wellness, delivered.
#MAIL_SITE_URL=https://www.shifaherbals.com
# Blank => a styled text wordmark is rendered instead of an <img> logo.
#MAIL_LOGO_URL=
#MAIL_SUPPORT_EMAIL=support@shifaherbals.com
#MAIL_SUPPORT_PHONE=+91 93025 90767
#MAIL_PRIMARY_COLOR=#1b5e20
#MAIL_ACCENT_COLOR=#c8a44d
#MAIL_FOOTER_CREDIT=Designed & Developed by Weblithic
#MAIL_FOOTER_CREDIT_URL=https://www.weblithic.com/

# --- Backups (nightly mysqldump -> local file / Object Storage) --------------
# mysqldump is on PATH after installing mysql-client on Ubuntu.
MYSQLDUMP_PATH=mysqldump
BACKUP_CRON=0 0 2 * * *

# --- JVM tuning for a small free-tier VM (optional) --------------------------
JAVA_OPTS=-Xms256m -Xmx768m
