# =============================================================================
# Shifa OMS backend environment (production).
# Copy to /etc/shifa/shifa.env on the server and fill in real values.
# Loaded by the systemd unit (EnvironmentFile). NEVER commit real secrets.
# =============================================================================

# Run with the production Spring profile
SPRING_PROFILES_ACTIVE=prod

# --- Database (self-hosted MySQL 8 on the same VM) ---------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shifa_dashboard
DB_USERNAME=shifa
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# --- Security ---------------------------------------------------------------
# Long random string (>= 32 chars). Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET

# Initial seeded admin (created on first boot if missing)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_PACKING_USERNAME=packer
SEED_PACKING_PASSWORD=CHANGE_ME_PACKER_PASSWORD

# --- Integrations (kept in MOCK/SANDBOX for the demo) ------------------------
PAYMENT_MODE=SANDBOX
PAYMENT_SANDBOX_SECRET=CHANGE_ME_SANDBOX_SECRET
COURIER_MODE=MOCK
WHATSAPP_MODE=MOCK

# --- Shopify order ingestion (spec: shopify-quikshipx-order-sync) ------------
# Master switch. false (default) = the webhook verifies and STORES each delivery
# for inspection/replay but creates no order. Turn on once the Shopify app's
# orders/create webhook points at https://<host>/api/webhooks/shopify/orders.
SHOPIFY_ENABLED=false
# The Shopify app's webhook signing secret (base64 HMAC-SHA256 of the raw body).
# A BLANK secret rejects every delivery with 401 — deliberately fails closed, so
# order creation is never an unauthenticated endpoint.
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_SHOP_DOMAIN=
# Largest accepted body, checked before the HMAC. Clamped to 256KB..8MB.
SHOPIFY_MAX_PAYLOAD_BYTES=1048576
# 1 attempt + 3 retries at 30/60/120s.
SHOPIFY_MAX_ATTEMPTS=4
# Shopify already emails the buyer; leave true to avoid double-messaging.
SHOPIFY_SUPPRESS_CUSTOMER_MESSAGING=true

# --- QuikShipX courier aggregator (spec: shopify-quikshipx-order-sync) -------
# Contract: docs/QUIKSHIPX-API-V1.md. ONE operation: POST /api/create-order-v1.
#
# Master switch. false (default) = approval generates the internal Code128 label
# and the packing queue behaves exactly as before this feature. Turn on only after
# QUIKSHIPX_CLIENT_CODE/USER_ID/USER_SECRET are set AND an admin has configured the
# pickup warehouse id on the Settings page (publication is blocked without it).
QUIKSHIPX_ENABLED=false
# MOCK (deterministic, no network — safe in production) or HTTP (live API).
QUIKSHIPX_MODE=MOCK
QUIKSHIPX_BASE_URL=https://head.quikshipx.com
# Credentials travel in the request BODY (shipper_details), not a header.
QUIKSHIPX_CLIENT_CODE=
QUIKSHIPX_USER_ID=
QUIKSHIPX_USER_SECRET=
# TEST files orders under QuikShipX's "Test" section, LIVE under "Pending".
# Keep TEST until the end-to-end flow has been verified against the real API.
QUIKSHIPX_SECRET_MODE=TEST
# The API has no channel field, so the channel rides in customer_order_id.
QUIKSHIPX_ORDER_REFERENCE_PREFIX=SHIFA-
# QuikShipX documents NO status webhook and NO status query, so status mirroring
# stays off and Shifa shows "status maintained in the QuikShipX portal".
QUIKSHIPX_STATUS_FEED_AVAILABLE=false
QUIKSHIPX_WEBHOOK_SECRET=

# --- Meta (Facebook/Instagram) Lead Ads ingestion (spec: meta-lead-sync) -----
# Auto-imports Lead Ads submissions into the Leads pipeline, owned by the
# "meta-leads" system user. Webhook endpoint: https://<host>/api/webhooks/meta
#
# Master switch. false (default) = the webhook verifies + STORES each delivery for
# inspection/replay but captures no lead. Set true once the Meta app's webhook is
# confirmed and the secrets below are filled in.
META_ENABLED=true
# Graph client backend: HTTP for real Meta leads (prod), MOCK for offline demo.
META_MODE=HTTP
# App secret (Meta App -> App settings -> Basic -> App Secret). Meta signs the
# webhook body with this; a BLANK secret rejects every delivery with 401.
META_APP_SECRET=
# Long-lived (system-user) Page access token with the leads_retrieval permission.
META_PAGE_ACCESS_TOKEN=
# A random string YOU invent; paste the SAME value into the Meta Webhooks panel
# as the "Verify Token" when subscribing the callback URL.
META_VERIFY_TOKEN=
# The business Page id running the lead ads.
META_PAGE_ID=105357624712950
# Optional: Graph API version + ingest retry policy (sensible defaults shown).
#META_GRAPH_VERSION=v21.0
#META_MAX_ATTEMPTS=4

# --- Email (MOCK logs only; SMTP sends via Gmail app password) ---------------
MAIL_MODE=MOCK
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Shifa Herbal Remedies <no-reply@shifa.local>
# Daily sales digest recipient(s); blank disables the digest email
REPORT_DIGEST_TO=
REPORT_DIGEST_CRON=0 30 6 * * *
# Whether the app's INTERNAL scheduler sends the consolidated daily report.
# true (default) = app sends it. false = an external AWS Lambda triggers
# POST /api/admin/reports/daily-digest/run (set false only to avoid a double-send).
REPORT_DIGEST_ENABLED=true

# --- Branded HTML email templates (app.mail.brand.*) -------------------------
# All optional; sensible on-brand defaults are used when unset.
#MAIL_BRAND_NAME=Shifa Herbal Remedies
#MAIL_BRAND_TAGLINE=Pure herbal wellness, delivered.
#MAIL_SITE_URL=https://www.shifaherbals.com
# Blank => a styled text wordmark is rendered instead of an <img> logo.
#MAIL_LOGO_URL=
#MAIL_SUPPORT_EMAIL=support@shifaherbals.com
#MAIL_SUPPORT_PHONE=+91 93025 90767
#MAIL_PRIMARY_COLOR=#1b5e20
#MAIL_ACCENT_COLOR=#c8a44d
#MAIL_FOOTER_CREDIT=Designed & Developed by Weblithic
#MAIL_FOOTER_CREDIT_URL=https://www.weblithic.com/

# --- File storage (payment screenshots + internal label PDFs) ----------------
# Where binary objects are stored:
#   S3    - Amazon S3 bucket (recommended for prod; durable, off the server disk)
#   DB    - stored_files table in MySQL (simplest; no AWS setup, backed up w/ the DB)
#   LOCAL - server filesystem (dev only; /opt/shifa must be writable)
# IMPORTANT: with S3 the app FAILS TO START if STORAGE_S3_BUCKET is blank. If you
# have not created an S3 bucket + IAM access yet, set STORAGE_PROVIDER=DB instead.
STORAGE_PROVIDER=S3
# Required when STORAGE_PROVIDER=S3 — the target bucket name:
STORAGE_S3_BUCKET=CHANGE_ME_S3_BUCKET
STORAGE_S3_REGION=ap-south-1
# Optional shared prefix inside the bucket (e.g. shifa/). Blank = bucket root.
STORAGE_S3_PREFIX=
# Prefer an EC2 instance role (leave these blank). Only set for non-EC2 hosts;
# inject via env, NEVER commit real keys.
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
# Optional S3-compatible endpoint (MinIO/LocalStack); blank = real AWS S3.
STORAGE_S3_ENDPOINT=

# --- Uploads (phone payment screenshots are commonly 2-5 MB) -----------------
MAX_UPLOAD_FILE_SIZE=10MB
MAX_UPLOAD_REQUEST_SIZE=12MB

# --- Backups (nightly mysqldump -> local file / Object Storage) --------------
# mysqldump is on PATH after installing mysql-client on Ubuntu.
MYSQLDUMP_PATH=mysqldump
BACKUP_CRON=0 0 2 * * *

# --- JVM tuning for a small free-tier VM (optional) --------------------------
JAVA_OPTS=-Xms256m -Xmx768m
