# =============================================================================
# PER-CLIENT backend environment template (white-label OMS).
#
# Copy this to the client's server as /etc/shifa/shifa.env and fill in the
# CHANGE_ME values. Each client gets its OWN server, OWN database, OWN JWT
# secret, OWN domain — deployments are fully isolated (separate-deployment model).
#
# This runs the `demo` Spring profile by default (integrations MOCK/off, storage
# in the DB) which is ideal for a client sandbox/demo. For a client that will
# take REAL orders/couriers/payments, switch SPRING_PROFILES_ACTIVE=prod and
# fill in the real integration + S3 settings (see deploy/shifa.env.example).
# =============================================================================

# --- Spring profile ----------------------------------------------------------
# demo = sandbox (QuikShipX off, storage DB, mail/whatsapp/courier MOCK).
# prod = live integrations (then also configure S3 + QuikShipX + mail below).
SPRING_PROFILES_ACTIVE=demo

# --- White-label brand (THE per-client identity) -----------------------------
# Shown on order codes, invoice/label/report PDFs, and email sign-offs. The full
# seller legal name / address / GSTIN are set in the app under Settings (stored
# in app_settings) and OVERRIDE these; these are the fallbacks + the order prefix.
BRAND_NAME=CHANGE_ME_CLIENT_BRAND
# Short uppercase order-code prefix, e.g. ACME-  (order codes become ACME-20260101-A1B2)
BRAND_ORDER_CODE_PREFIX=CHANGE_ME_PREFIX-
# Brand name used in HTML/plain-text emails (usually same as BRAND_NAME).
MAIL_BRAND_NAME=CHANGE_ME_CLIENT_BRAND

# --- CORS: the client's own browser origin(s) --------------------------------
# The domain the admin app is served from. localhost is always allowed for dev.
CORS_ORIGINS=https://CHANGE_ME_CLIENT_DOMAIN

# --- Database (self-hosted MySQL 8 on the client's VM; create it EMPTY first) --
# The DB must be empty on first boot — Flyway seeds use explicit IDs.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=CHANGE_ME_CLIENT_DB
DB_USERNAME=shifa
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# --- Security ----------------------------------------------------------------
# UNIQUE per client. Generate: openssl rand -base64 48  (>= 32 chars)
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET

# Initial seeded users (created on first boot into the empty DB)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_PACKING_USERNAME=packer
SEED_PACKING_PASSWORD=CHANGE_ME_PACKER_PASSWORD

# --- Storage -----------------------------------------------------------------
# DB = simplest (binary objects in MySQL, backed up with the DB; no AWS needed).
# Switch to S3 for a high-volume live client (see deploy/shifa.env.example).
STORAGE_PROVIDER=DB

# --- Integrations: MOCK/OFF for a demo/sandbox -------------------------------
# For a LIVE client, flip these on and supply real credentials (QuikShipX etc.).
QUIKSHIPX_ENABLED=false
QUIKSHIPX_MODE=MOCK
PAYMENT_MODE=SANDBOX
COURIER_MODE=MOCK
WHATSAPP_MODE=MOCK
MAIL_MODE=MOCK

# --- Uploads -----------------------------------------------------------------
MAX_UPLOAD_FILE_SIZE=10MB
MAX_UPLOAD_REQUEST_SIZE=12MB

# --- Backups -----------------------------------------------------------------
MYSQLDUMP_PATH=mysqldump
BACKUP_CRON=0 0 2 * * *

# --- JVM tuning for a small VM -----------------------------------------------
JAVA_OPTS="-Xms256m -Xmx768m"
