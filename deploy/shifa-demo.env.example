# Shifa OMS demo/sandbox environment template.
# Copy outside the repository and fill in real demo-only values.
# NEVER commit the populated file or reuse these values for production.
SPRING_PROFILES_ACTIVE=demo
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shifa_demo
DB_USERNAME=shifa
DB_PASSWORD=CHANGE_ME_DEMO_DB_PASSWORD
JWT_SECRET=CHANGE_ME_DEMO_ONLY_LONG_RANDOM_JWT_SECRET
MFA_ENCRYPTION_KEY=CHANGE_ME_DEMO_ONLY_MFA_ENCRYPTION_KEY
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_DEMO_ADMIN_PASSWORD
SEED_PACKING_USERNAME=packer
SEED_PACKING_PASSWORD=CHANGE_ME_DEMO_PACKER_PASSWORD
STORAGE_PROVIDER=DB
WEBHOOK_HMAC_STRICT=false
COURIER_WEBHOOK_HMAC_SECRET=
SHOPIFY_WEBHOOK_HMAC_SECRET=
QUIKSHIPX_ENABLED=false
QUIKSHIPX_MODE=MOCK
PAYMENT_MODE=SANDBOX
COURIER_MODE=MOCK
WHATSAPP_MODE=MOCK
MAIL_MODE=MOCK
JAVA_OPTS="-Xms256m -Xmx512m"
